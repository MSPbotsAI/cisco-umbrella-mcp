# ─── Cisco Umbrella API Credentials ──────────────────────────────────────────
# Used in env mode (single shared credential loaded from environment).
# Not required when AUTH_MODE=gateway (credentials are provided per-request via headers).
UMBRELLA_API_KEY=your_api_key
UMBRELLA_KEY_SECRET=your_key_secret

# HTTP header names that carry the API key + key secret in gateway mode.
# The client must send both headers on every /mcp request.
UMBRELLA_API_KEY_HEADER=X-Umbrella-Api-Key
UMBRELLA_KEY_SECRET_HEADER=X-Umbrella-Key-Secret

# ─── MCP Transport ───────────────────────────────────────────────────────────
# "http"  — stateless HTTP server (required for production / multi-tenant use)
# "stdio" — local stdio transport (useful for development / CLI use)
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# ─── Auth Mode ───────────────────────────────────────────────────────────────
# "gateway" — (default, SOP-compliant) API key + key secret provided per-request via HTTP headers
#             Required for production / multi-tenant deployments (e.g. behind mcp-gateway).
# "env"     — (local dev only) single API key + key secret loaded from env vars above
#             NOT SOP-compliant: credentials are shared across all requests; do not use in production.
AUTH_MODE=gateway
